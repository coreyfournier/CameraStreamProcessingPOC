{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: ReadFromStreamPoc2",
            "type": "debugpy",
            "request": "launch",
            "program": "ReadFromStreamPoc2.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Python Debugger: ExportLightroomFaces",
            "type": "debugpy",
            "request": "launch",
            "program": "ExportLightroomFaces.py",
            "console": "integratedTerminal",
            "args": [
                "--catalog", "${input:catalogPath}",
                "--output", "./faces/",
                "--skip-encodings"
            ]
        }
    ],
    "inputs": [
        {
            "id": "catalogPath",
            "type": "promptString",
            "description": "Path to Lightroom .lrcat catalog file"
        }
    ]
}